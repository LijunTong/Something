{
  "name": "something",
  "version": "1.0.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:vite": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node scripts/start.cjs",
    "electron:dev": "node scripts/start.cjs",
    "rebuild": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "grid-layout-plus": "1.1.1",
    "naive-ui": "^2.45.3",
    "pinia": "^2.3.0",
    "unplugin-vue-components": "^32.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.5",
    "vue-tsc": "^3.3.14"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "better-sqlite3@11.10.0": true
  },
  "build": {
    "appId": "com.something.jijianshi",
    "productName": "Something",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "migrations/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "electron/assets/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "几件事",
      "artifactName": "Something-Setup-${version}.exe"
    },
    "electronDist": "node_modules/electron/dist"
  },
  "description": "几件事（Something）：本地优先的待办 / 日程 / 番茄钟 / 信息流 / 快递 / 邮件 / 天气",
  "author": {
    "name": "Joont"
  }
}
